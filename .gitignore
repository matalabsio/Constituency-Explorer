# Keep only the root gitignore. All other dotfiles/dotdirs stay local.
.*
!/.gitignore

# Secrets
*.pem
*.key
credentials.json

# Python
*.pyc
__pycache__/
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Local crawl data (bundled copy for Vercel lives at dashboard/data/kurupam.db)
data/*.db
data/*.db-wal
data/*.db-shm
data/storage/
data/exports/
data/logs/
data/manifests/
data/skills/

# Local agent / editor copies (not product code)
agent/
skills-lock.json
dashboard/AGENTS.md
dashboard/CLAUDE.md
dashboard/.git.bak/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
